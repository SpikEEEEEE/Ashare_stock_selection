{
  "data": {
    "date_col": "date",
    "code_col": "code",
    "industry_col": "industry"
  },
  "universe": {
    "min_listing_days": 120,
    "min_price": 2.0,
    "min_avg_amount": 20000000.0,
    "liquidity_window": 20,
    "exclude_st": true,
    "exclude_suspended": true,
    "exclude_limit_up_for_buy": true
  },
  "features": {
    "prediction_horizon": 5,
    "momentum_windows": [5, 10, 20, 60],
    "volatility_windows": [20, 60],
    "min_feature_history": 60,
    "generated_feature_path": null
  },
  "model": {
    "train_lookback_days": 500,
    "min_train_days": 240,
    "min_train_rows": 5000,
    "target_winsor_quantile": 0.01,
    "n_estimators": 300,
    "learning_rate": 0.03,
    "num_leaves": 31,
    "max_depth": -1,
    "min_child_samples": 200,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_alpha": 0.1,
    "reg_lambda": 1.0,
    "random_state": 42,
    "n_jobs": -1
  },
  "selection": {
    "top_k": 200,
    "max_industry_fraction": 0.15,
    "volatility_penalty": 0.05,
    "illiquidity_penalty": 0.05,
    "buffer_exit_multiplier": 1.5
  },
  "backtest": {
    "rebalance_every_days": 5,
    "max_periods": 60
  },
  "tushare": {
    "token_env": "TUSHARE_TOKEN",
    "cache_dir": "data/tushare_cache",
    "request_interval_seconds": 0.13,
    "max_retries": 5,
    "retry_backoff_seconds": 2.0,
    "refresh_last_trading_days": 2,
    "include_name_history": true
  },
  "deepseek": {
    "api_key_env": "DEEPSEEK_API_KEY",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-v4-pro",
    "thinking_enabled": true,
    "temperature": 0.2,
    "max_tokens": 8000,
    "timeout_seconds": 120.0,
    "max_retries": 3,
    "retry_backoff_seconds": 2.0,
    "proposal_count": 30
  },
  "feature_screening": {
    "min_feature_coverage": 0.8,
    "min_screening_days": 120,
    "min_cross_sectional_stocks": 100,
    "min_abs_mean_ic": 0.002,
    "min_abs_ic_tstat": 1.0,
    "max_pairwise_correlation": 0.85,
    "correlation_sample_rows": 200000,
    "max_selected_features": 30
  }
}
