{
  "universe": {
    "min_listing_days": 60,
    "min_price": 2.0,
    "min_avg_amount": 5000000.0,
    "liquidity_window": 20
  },
  "features": {
    "prediction_horizon": 5,
    "min_feature_history": 40,
    "generated_feature_path": null
  },
  "model": {
    "train_lookback_days": 320,
    "min_train_days": 180,
    "min_train_rows": 5000,
    "target_winsor_quantile": 0.01,
    "n_estimators": 100,
    "learning_rate": 0.05,
    "num_leaves": 15,
    "max_depth": -1,
    "min_child_samples": 50,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_alpha": 0.1,
    "reg_lambda": 1.0,
    "random_state": 42,
    "n_jobs": -1
  },
  "selection": {
    "top_k": 20,
    "max_industry_fraction": 0.2,
    "volatility_penalty": 0.05,
    "illiquidity_penalty": 0.05,
    "buffer_exit_multiplier": 1.5
  },
  "backtest": {
    "rebalance_every_days": 5,
    "max_periods": 20
  },
  "tushare": {
    "token_env": "TUSHARE_TOKEN",
    "cache_dir": "data/tushare_cache",
    "request_interval_seconds": 0.13,
    "max_retries": 5,
    "retry_backoff_seconds": 2.0,
    "refresh_last_trading_days": 2,
    "include_name_history": true
  },
  "deepseek": {
    "api_key_env": "DEEPSEEK_API_KEY",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-v4-pro",
    "thinking_enabled": true,
    "temperature": 0.2,
    "max_tokens": 8000,
    "timeout_seconds": 120.0,
    "max_retries": 3,
    "retry_backoff_seconds": 2.0,
    "proposal_count": 20
  },
  "feature_screening": {
    "min_feature_coverage": 0.75,
    "min_screening_days": 60,
    "min_cross_sectional_stocks": 20,
    "min_abs_mean_ic": 0.0,
    "min_abs_ic_tstat": 0.0,
    "max_pairwise_correlation": 0.85,
    "correlation_sample_rows": 50000,
    "max_selected_features": 10
  }
}
