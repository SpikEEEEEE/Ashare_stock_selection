{
  "universe": {
    "min_listing_days": 120,
    "min_price": 2.0,
    "min_avg_amount": 20000000.0,
    "liquidity_window": 20,
    "exclude_st": true,
    "exclude_suspended": true,
    "exclude_limit_up_for_buy": true
  },
  "features": {
    "prediction_horizon": 5,
    "momentum_windows": [5, 10, 20, 60],
    "volatility_windows": [20, 60],
    "min_feature_history": 60
  },
  "model": {
    "ridge_alpha": 20.0,
    "train_lookback_days": 500,
    "min_train_days": 240,
    "min_train_rows": 500000,
    "target_winsor_quantile": 0.01
  },
  "selection": {
    "top_k": 20,
    "max_industry_fraction": 0.12,
    "volatility_penalty": 0.05,
    "illiquidity_penalty": 0.05,
    "buffer_exit_multiplier": 1.5
  },
  "backtest": {
    "rebalance_every_days": 5,
    "max_periods": 60
  },
  "tushare": {
    "token_env": "TUSHARE_TOKEN",
    "cache_dir": "data/tushare_cache",
    "request_interval_seconds": 0.13,
    "max_retries": 5,
    "retry_backoff_seconds": 2.0,
    "refresh_last_trading_days": 2,
    "include_name_history": true
  }
}

